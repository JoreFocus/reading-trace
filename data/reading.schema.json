{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reading-trace.local/reading.schema.json",
  "title": "Reading Trace document",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "summary", "thesis", "invitation", "source", "roleLabels", "groups"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "thesis": { "type": "string", "minLength": 1 },
    "invitation": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url", "licenseNote"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "licenseNote": { "type": "string", "minLength": 1 }
      }
    },
    "roleLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "support", "turn"],
      "properties": {
        "core": { "type": "string", "minLength": 1 },
        "support": { "type": "string", "minLength": 1 },
        "turn": { "type": "string", "minLength": 1 }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "index", "kicker", "shortTitle", "title", "description", "items"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "index": { "type": "string", "minLength": 1 },
          "kicker": { "type": "string", "minLength": 1 },
          "shortTitle": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "role", "quote", "context", "prompt"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "role": { "type": "string", "enum": ["core", "support", "turn"] },
                "quote": { "type": "string", "minLength": 1 },
                "context": { "type": "string", "minLength": 1 },
                "prompt": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
